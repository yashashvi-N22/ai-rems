# ==============================================================================
# AI-REMS Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="AI-REMS Microgrid Platform"

# Microgrid Physical Plant Parameters
PLANT_LOCATION_NAME="Charanka Solar-Wind Hybrid Park, Gujarat, India"
PLANT_LATITUDE=23.90
PLANT_LONGITUDE=71.20
PLANT_CAPACITY_SOLAR_KW=100.0
PLANT_CAPACITY_WIND_KW=100.0
WIND_TURBINE_HUB_HEIGHT_M=100.0
WIND_TURBINE_ROTOR_DIAMETER_M=52.0

# Battery Energy Storage Subsystem (BESS)
BESS_CAPACITY_KWH=200.0
BESS_MAX_POWER_KW=50.0
BESS_MIN_SOC_PCT=15.0
BESS_MAX_SOC_PCT=95.0
BESS_INITIAL_SOC_PCT=65.0
BESS_ROUND_TRIP_EFFICIENCY=0.95
BESS_NOMINAL_VOLTAGE_V=400.0

# Grid & Financial Tariffs (INR)
GRID_BUY_TARIFF_BASE_INR_PER_KWH=7.50
GRID_BUY_TARIFF_PEAK_INR_PER_KWH=11.00
GRID_BUY_TARIFF_OFFPEAK_INR_PER_KWH=6.40
GRID_FEED_IN_TARIFF_INR_PER_KWH=3.20
GRID_CARBON_INTENSITY_KG_PER_KWH=0.82

# Multi-Objective Optimization Default Weights (Must sum to 1.0)
OPTIMIZER_DEFAULT_COST_WEIGHT=0.50
OPTIMIZER_DEFAULT_CARBON_WEIGHT=0.30
OPTIMIZER_DEFAULT_BATTERY_HEALTH_WEIGHT=0.20

# Live Weather API Ingestion
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_POLL_INTERVAL_MINUTES=5
TELEMETRY_SIMULATION_INTERVAL_SEC=0.5

# Optional Grounded GenAI Assistant (Google Gemini API Key)
# If left blank, AI-REMS automatically uses its internal zero-latency domain-grounded expert synthesizer.
GEMINI_API_KEY=
